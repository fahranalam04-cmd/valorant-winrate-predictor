# Secrets — never commit
.env
*.key

# Collected data: contains other players' match histories. Stays local.
data/
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3

# Downloaded game art: 33 MB of Riot's PNGs, regenerated in one command by
# tools/fetch_agent_art.py. Generated asset, not source -- same reasoning as
# models/ below.
valwr/dash/static/agents/
valwr/dash/static/maps/

# The interactive demo build. Published to the gh-pages branch by
# tools/build_pages_demo.py, never committed to main -- it carries a copy of
# the Riot artwork above.
site/

# Trained artefacts
models/
*.pkl
*.joblib
*.cbm
*.txt.model

# Coverage output -- a binary artefact of running the tests
.coverage
.coverage.*
htmlcov/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/
.mypy_cache/

# Notebook outputs can contain API keys and player data
*.nbconvert.ipynb

# Reports that embed data
reports/*.html
!reports/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
