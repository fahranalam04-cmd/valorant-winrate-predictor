# Copy to .env and fill in. .env is gitignored — never commit real keys.

# HenrikDev API key. Generate at https://api.henrikdev.xyz/dashboard/
# (requires joining their Discord). Basic tier = 30 req/min.
HENRIK_API_KEY=

# Your tier, so the rate limiter configures itself correctly.
# basic = 30 req/min, enhanced = 90 req/min
HENRIK_TIER=basic

# Anthropic API key for the coaching layer (Phase 8 only — leave blank until then).
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Region and platform. Baked into every API path.
# region: na | eu | ap | kr | latam | br
REGION=na
PLATFORM=pc

# Your own Riot ID, used to seed the crawler and to smoke-test in Phase 0.
# Split on the '#' -- for "Fahran#NA1", name is Fahran and tag is NA1.
# Do not put the '#' in RIOT_NAME; it goes straight into the request URL.
RIOT_NAME=
RIOT_TAG=

# Storage
DATABASE_PATH=data/valwr.db

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
